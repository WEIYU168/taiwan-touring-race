{
  // Cloudflare Workers 設定：靜態遊戲檔 + 對戰用 Durable Object（每房一個、另有配對大廳）
  "name": "taiwan-touring-race",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // 只有 /ws 與 /api/* 先交給 Worker，其餘網址直接回傳靜態檔
    "run_worker_first": ["/ws", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Hub"] },
    // v2：改成「每房一個 Room」+「配對大廳 Lobby」，移除舊的單一 Hub（沒有需要保留的資料）
    { "tag": "v2", "new_sqlite_classes": ["Room", "Lobby"], "deleted_classes": ["Hub"] }
  ]
}
